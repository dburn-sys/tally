# The app connects as tally_app, which owns no tables (ADR-0001).
DATABASE_URL=postgres://tally_app:tally_app@localhost:5432/tally
# Migrations and test setup connect as the table owner.
MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:5432/tally
TALLY_APP_PASSWORD=tally_app
TALLY_SIGNING_KEY=your-signing-key-here
